# Copiază acest fișier ca `.env` DEASUPRA folderului public_html (ex: /home/user/.env)
# și completează valorile. Nu pune niciodată .env în git.
APP_ENV=production
BASE_URL=https://veedo.ro

DB_HOST=localhost
DB_NAME=veedo1_site
DB_USER=
DB_PASS=

# Web Push (opțional) — chei VAPID generate o singură dată
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
